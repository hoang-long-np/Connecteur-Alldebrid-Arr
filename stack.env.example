# Variables à renseigner dans Dockhand (variables d'environnement de la stack).
# Ne jamais mettre la vraie clé API dans le dépôt Git.

# Clé API AllDebrid : https://alldebrid.com/apikeys/
ALLDEBRID_API_KEY=

# Dossier de téléchargement sur le NAS…
DOWNLOADS_HOST_PATH=/mnt/tank/media/downloads
# …et son chemin DANS les conteneurs Radarr/Sonarr (évite les « Remote Path Mappings »)
DOWNLOADS_CONTAINER_PATH=/media/downloads

# Utilisateur/groupe de Radarr/Sonarr (568 = « apps » sur TrueNAS)
ARR_UID=568
ARR_GID=568

# Port du NAS et identifiants à saisir dans Radarr/Sonarr
HOST_PORT=8090
QBIT_USERNAME=admin
QBIT_PASSWORD=
