# Clé API AllDebrid : https://alldebrid.com/apikeys/
ALLDEBRID_API_KEY=
# Retire le magnet d'AllDebrid une fois téléchargé (ou supprimé par Radarr/Sonarr)
ALLDEBRID_CLEANUP=true

# Dossier de téléchargement : Radarr/Sonarr doivent pouvoir y accéder
DOWNLOAD_DIR=downloads
# Dossier où est sauvegardé l'état des téléchargements
DATA_DIR=data

# API compatible qBittorrent à renseigner dans Radarr/Sonarr
HOST=0.0.0.0
PORT=8090
QBIT_USERNAME=admin
# Laisser vide pour désactiver l'authentification
QBIT_PASSWORD=

# Nombre de fichiers téléchargés en parallèle
MAX_CONCURRENT_DOWNLOADS=3
# Fréquence de vérification du statut AllDebrid
POLL_INTERVAL_SECONDS=5
# debug, info, warn ou error
LOG_LEVEL=info
