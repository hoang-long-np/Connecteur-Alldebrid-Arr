# Variables de la stack complète (connecteur + Radarr + Sonarr + Prowlarr + Bazarr).
# Ne jamais mettre la vraie clé API dans le dépôt Git.

# Clé API AllDebrid : https://alldebrid.com/apikeys/
ALLDEBRID_API_KEY=

# Dossier racine des données sur l'hôte : contiendra torrents/ et media/
DATA_PATH=/mnt/tank/data

# Utilisateur/groupe propriétaire des fichiers (568 = « apps » sur TrueNAS)
ARR_UID=568
ARR_GID=568

TZ=Europe/Paris

# Identifiants du connecteur, à saisir dans Radarr/Sonarr (mot de passe vide = pas d'authentification)
QBIT_USERNAME=admin
QBIT_PASSWORD=
